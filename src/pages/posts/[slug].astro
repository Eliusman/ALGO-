---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const homeUrl = `${import.meta.env.BASE_URL}`;
const img = post.data.modalImg || post.data.coverImage || '';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{post.data.title} | Algo + que Música y Radio</title>
    <meta name="description" content={post.data.description}>
    <link rel="canonical" href={`https://eliusman.github.io/ALGO-/posts/${post.slug}/`}>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400&family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;700&display=swap');
        
        :root {
            --ink: #1f1c18;
            --muted: #5c564c;
            --accent: #b53a28;
            --card: #d9d2c5;
            --line: #c5b8d4;
        }
        
        * { box-sizing: border-box; }
        
        body {
            margin: 0;
            min-height: 100vh;
            background-color: #0f172a;
            background-image:
                linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.80)),
                url("https://i.ibb.co/vvBZYSkQ/radio-vintage-taller-retro.jpg");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            color: var(--ink);
            font-family: "Literata", "Georgia", serif;
            line-height: 1.8;
            padding: 32px 4vw 80px;
        }
        
        .page-wrap {
            max-width: 1100px;
            margin: 0 auto;
        }
        
        .back-home {
            display: inline-block;
            margin-bottom: 24px;
            color: #fff;
            background: rgba(181, 58, 40, 0.92);
            font-family: "DM Sans", sans-serif;
            font-weight: 700;
            font-size: 0.95rem;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 8px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.18);
            transition: transform 0.2s, background 0.2s;
        }
        .back-home:hover {
            background: #9e3222;
            transform: translateY(-1px);
        }
        
        .article-container {
            background: var(--card);
            max-width: 100%;
            margin: 0 auto;
            border-radius: 16px;
            padding: 44px 40px;
            border: 1px solid var(--line);
            box-shadow: 
                0 6px 10px rgba(0,0,0,0.06),
                0 20px 50px rgba(0,0,0,0.16);
        }
        
        small {
            color: var(--muted);
            font-family: "DM Sans", sans-serif;
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
        
        h1 {
            font-family: "Space Grotesk", sans-serif;
            font-size: clamp(1.7rem, 3.2vw, 2.35rem);
            margin: 12px 0 28px;
            line-height: 1.25;
            color: var(--ink);
            font-weight: 700;
            letter-spacing: -0.02em;
        }
        
        img {
            max-width: 100%;
            height: auto;
            border-radius: 12px;
            margin: 6px 0 32px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.13);
        }
        
        .article-text {
            font-size: 1.13rem;
            color: var(--ink);
        }
        
        .article-text p {
            margin: 0 0 1.45em;
        }
        
        .article-text p:last-child {
            margin-bottom: 0;
        }
        
        .article-text strong {
            font-weight: 600;
            color: #15130f;
        }
        
        .article-text blockquote {
            margin: 1.8em 0;
            padding: 0.8em 0 0.8em 1.4em;
            border-left: 4px solid var(--accent);
            font-style: italic;
            color: #2c2822;
            background: rgba(181, 58, 40, 0.07);
            border-radius: 0 8px 8px 0;
        }
        
        .original-link {
            display: inline-block;
            margin-top: 32px;
            color: var(--accent);
            font-family: "DM Sans", sans-serif;
            font-weight: 700;
            font-size: 0.95rem;
            text-decoration: none;
        }
        .original-link:hover {
            text-decoration: underline;
        }
        

        /* Selector de idiomas también disponible en cada artículo */
        .article-language-section {
            margin: 0 0 22px;
            padding: 14px 16px;
            border-radius: 12px;
            background: linear-gradient(135deg, #172554, #312e81);
            box-shadow: 0 6px 18px rgba(0,0,0,.18);
            font-family: "DM Sans", sans-serif;
        }
        .article-language-title {
            margin: 0 0 10px;
            color: #fff;
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
        }
        #article-language-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        #article-language-tabs button {
            border: 1px solid rgba(255,255,255,.24);
            border-radius: 6px;
            padding: 7px 10px;
            background: rgba(255,255,255,.08);
            color: #fff;
            font: 700 .78rem "DM Sans", sans-serif;
            cursor: pointer;
        }
        #article-language-tabs button:hover,
        #article-language-tabs button:focus-visible {
            background: #e64b35;
        }
        .goog-te-banner-frame.skiptranslate { display: none !important; }
        body { top: 0 !important; }
        #google_translate_element { display: none; }
        .skiptranslate { font-size: 0 !important; }

        /* Escritorio */
        @media (min-width: 900px) {
            body {
                padding: 48px 5vw 100px;
            }
            .article-container {
                padding: 56px 64px;
            }
            .article-text {
                font-size: 1.16rem;
            }
            .back-home {
                font-size: 1rem;
                padding: 12px 22px;
            }
        }
        
        /* Pantallas grandes */
        @media (min-width: 1200px) {
            .page-wrap {
                max-width: 1180px;
            }
            .article-container {
                padding: 60px 72px;
            }
        }
        
        /* Móvil */
        @media (max-width: 600px) {
            body {
                background-attachment: scroll;
                padding: 20px 4vw 60px;
            }
            .article-container {
                padding: 28px 18px;
                border-radius: 12px;
            }
            .article-text {
                font-size: 1.05rem;
            }
            h1 {
                font-size: 1.5rem;
            }
            .back-home {
                font-size: 0.9rem;
                padding: 9px 16px;
            }
        }
    </style>
</head>
<body>
    <div class="page-wrap">
        <section class="article-language-section" aria-label="Traducir artículo">
            <p class="article-language-title notranslate" translate="no">🌐 Leer este artículo en otro idioma</p>
            <div id="article-language-tabs" class="notranslate" translate="no">
                <button type="button" onclick="changeArticleLanguage('ca')">Català</button>
                <button type="button" onclick="changeArticleLanguage('es')">Español</button>
                <button type="button" onclick="changeArticleLanguage('en')">English</button>
                <button type="button" onclick="changeArticleLanguage('fr')">Français</button>
                <button type="button" onclick="changeArticleLanguage('de')">Deutsch</button>
                <button type="button" onclick="changeArticleLanguage('it')">Italiano</button>
                <button type="button" onclick="changeArticleLanguage('pt')">Português</button>
                <button type="button" onclick="changeArticleLanguage('hi')">हिन्दी</button>
                <button type="button" onclick="changeArticleLanguage('zh-CN')">中文</button>
                <button type="button" onclick="changeArticleLanguage('ja')">日本語</button>
            </div>
        </section>
        <a class="back-home" href={homeUrl}>← Volver a la página principal</a>
        
        <main class="article-container">
            <small>{post.data.category}</small>
            <h1>{post.data.title}</h1>
            {img && <img src={img} alt={post.data.title} />}
            
            <div class="article-text">
                <Content />
            </div>

            {post.data.videoUrl && (
                <p><a href={post.data.videoUrl} target="_blank" rel="noopener noreferrer" class="original-link">▶ Ver vídeo original en YouTube ➔</a></p>
            )}
        </main>
    </div>

    <div id="google_translate_element"></div>
    <script is:inline>
        function googleTranslateElementInit() {
            if (window.google && window.google.translate) {
                new google.translate.TranslateElement({
                    pageLanguage: 'es',
                    includedLanguages: 'ca,es,en,fr,de,it,pt,hi,zh-CN,ja',
                    autoDisplay: false
                }, 'google_translate_element');
            }
        }

        function changeArticleLanguage(langCode) {
            var selectField = document.querySelector('.goog-te-combo');
            if (selectField) {
                selectField.value = langCode;
                selectField.dispatchEvent(new Event('change'));
            } else {
                // El selector de Google puede tardar unos instantes en cargarse.
                var attempts = 0;
                var retry = window.setInterval(function () {
                    var select = document.querySelector('.goog-te-combo');
                    attempts++;
                    if (select) {
                        window.clearInterval(retry);
                        select.value = langCode;
                        select.dispatchEvent(new Event('change'));
                    } else if (attempts >= 20) {
                        window.clearInterval(retry);
                        alert('No se ha podido cargar Google Translate. Comprueba tu conexión y vuelve a intentarlo.');
                    }
                }, 300);
            }
        }
    </script>
    <script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
</body>
</html>
