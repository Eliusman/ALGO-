---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const homeUrl = "../../index.html";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{post.data.title} | Algo + que Música y Radio</title>
    <meta name="description" content={post.data.description}>
    <link rel="canonical" href={`https://eliusman.github.io/ALGO-/posts/${post.slug}/`}>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400&family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;700&display=swap');
        
        :root {
            --ink: #1f1c18;
            --muted: #5c564c;
            --accent: #b53a28;
            --card: #d9d2c5;
            --line: #c5b8d4;
        }
        
        * { box-sizing: border-box; }
        
        body {
            margin: 0;
            min-height: 100vh;
            background: 
                radial-gradient(circle at 18% 22%, rgba(255,255,255,0.35) 0%, transparent 42%),
                radial-gradient(circle at 82% 78%, rgba(255,255,255,0.22) 0%, transparent 45%),
                radial-gradient(circle at 50% 110%, rgba(130,90,180,0.45) 0%, transparent 55%),
                linear-gradient(155deg, #9b85b8 0%, #b29bc9 30%, #c0b0d4 55%, #a894c0 80%, #8f7aad 100%);
            color: var(--ink);
            font-family: "Literata", "Georgia", serif;
            line-height: 1.8;
            padding: 32px 4vw 80px;
        }
        
        .page-wrap {
            max-width: 1100px;
            margin: 0 auto;
        }
        
        .back-home {
            display: inline-block;
            margin-bottom: 24px;
            color: #fff;
            background: rgba(181, 58, 40, 0.92);
            font-family: "DM Sans", sans-serif;
            font-weight: 700;
            font-size: 0.95rem;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 8px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.18);
            transition: transform 0.2s, background 0.2s;
        }
        .back-home:hover {
            background: #9e3222;
            transform: translateY(-1px);
        }
        
        .article-container {
            background: var(--card);
            max-width: 100%;
            margin: 0 auto;
            border-radius: 16px;
            padding: 44px 40px;
            border: 1px solid var(--line);
            box-shadow: 
                0 6px 10px rgba(0,0,0,0.06),
                0 20px 50px rgba(0,0,0,0.16);
        }
        
        small {
            color: var(--muted);
            font-family: "DM Sans", sans-serif;
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
        
        h1 {
            font-family: "Space Grotesk", sans-serif;
            font-size: clamp(1.7rem, 3.2vw, 2.35rem);
            margin: 12px 0 28px;
            line-height: 1.25;
            color: var(--ink);
            font-weight: 700;
            letter-spacing: -0.02em;
        }
        
        img {
            max-width: 100%;
            height: auto;
            border-radius: 12px;
            margin: 6px 0 32px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.13);
        }
        
        .article-text {
            font-size: 1.13rem;
            color: var(--ink);
        }
        
        .article-text p {
            margin: 0 0 1.45em;
        }
        
        .article-text p:last-child {
            margin-bottom: 0;
        }
        
        .article-text strong {
            font-weight: 600;
            color: #15130f;
        }
        
        .article-text blockquote {
            margin: 1.8em 0;
            padding: 0.8em 0 0.8em 1.4em;
            border-left: 4px solid var(--accent);
            font-style: italic;
            color: #2c2822;
            background: rgba(181, 58, 40, 0.07);
            border-radius: 0 8px 8px 0;
        }
        
        .original-link {
            display: inline-block;
            margin-top: 32px;
            color: var(--accent);
            font-family: "DM Sans", sans-serif;
            font-weight: 700;
            font-size: 0.95rem;
            text-decoration: none;
        }
        .original-link:hover {
            text-decoration: underline;
        }
        
        /* Escritorio */
        @media (min-width: 900px) {
            body {
                padding: 48px 5vw 100px;
            }
            .article-container {
                padding: 56px 64px;
            }
            .article-text {
                font-size: 1.16rem;
            }
            .back-home {
                font-size: 1rem;
                padding: 12px 22px;
            }
        }
        
        /* Pantallas grandes */
        @media (min-width: 1200px) {
            .page-wrap {
                max-width: 1180px;
            }
            .article-container {
                padding: 60px 72px;
            }
        }
        
        /* Móvil */
        @media (max-width: 600px) {
            body {
                padding: 20px 4vw 60px;
            }
            .article-container {
                padding: 28px 18px;
                border-radius: 12px;
            }
            .article-text {
                font-size: 1.05rem;
            }
            h1 {
                font-size: 1.5rem;
            }
            .back-home {
                font-size: 0.9rem;
                padding: 9px 16px;
            }
        }
    </style>
</head>
<body>
    <div class="page-wrap">
        <a class="back-home" href={homeUrl}>← Volver a la página principal</a>
        
        <main class="article-container">
            <small>{post.data.category}</small>
            <h1>{post.data.title}</h1>
            {post.data.modalImg && <img src={post.data.modalImg} alt={post.data.title} />}
            
            <div class="article-text">
                <Content />
            </div>

            {post.data.videoUrl && (
                <p><a href={post.data.videoUrl} target="_blank" rel="noopener noreferrer" class="original-link">▶ Ver vídeo original en YouTube ➔</a></p>
            )}
        </main>
    </div>
</body>
</html>

