---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{post.data.title} | Algo + que Música y Radio</title>
    <meta name="description" content={post.data.description}>
    <link rel="canonical" href={`https://eliusman.github.io/ALGO-/posts/${post.slug}/`}>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;700&display=swap');
        :root {
            --bg:#f5f2ec;
            --ink:#171717;
            --muted:#6e6a63;
            --accent:#e64b35;
            --card:#ffffff;
            --line:#ddd7cc;
        }
        *{box-sizing:border-box}
        body{margin:0;background:var(--bg);color:var(--ink);font-family:"DM Sans",sans-serif;line-height:1.7;padding:40px 7vw;}
        .back-home{display:inline-block;margin-bottom:20px;color:var(--accent);font-weight:700;text-decoration:none;}
        .back-home:hover{text-decoration:underline;}
        .article-container{background:var(--card);max-width:750px;margin:0 auto;border-radius:12px;padding:40px;border:1px solid var(--line);box-shadow:0 10px 30px rgba(0,0,0,0.1);}
        small{color:var(--muted);font-size:.78rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;}
        h1{font-family:"Space Grotesk",sans-serif;font-size:clamp(1.8rem, 3vw, 2.3rem);margin:10px 0 20px;line-height:1.2;color:var(--ink);}
        img{max-width:100%;height:auto;border-radius:8px;margin:20px 0;}
        .article-text {font-size: 1.05rem; color: var(--ink); margin-top: 20px;}
        .article-text p {margin-bottom: 1.2rem;}
        .original-link{display:inline-block;margin-top:20px;color:var(--accent);font-weight:700;text-decoration:none;}
        .original-link:hover{text-decoration:underline;}
    </style>
</head>
<body>
    <a class="back-home" href="/ALGO-/">← Volver a la página principal</a>
    <main class="article-container">
        <small>CIENCIA</small>
        <h1>{post.data.title}</h1>
        {post.data.modalImg && <img src={post.data.modalImg} alt={post.data.title} />}
        
        <div class="article-text">
            <p><strong>{post.data.description}</strong></p>
            <p>Hace millones de años, la historia de nuestro hogar pudo haber terminado antes de empezar. O al menos, eso dice la teoría científica más aceptada sobre el origen de la Luna tras la colisión con Theia.</p>
        </div>

        {post.data.videoUrl && (
            <p><a href={post.data.videoUrl} target="_blank" rel="noopener noreferrer" class="original-link">▶ Ver vídeo original en YouTube ➔</a></p>
        )}
    </main>
</body>
</html>
