---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Ruta de vuelta exacta usando ruta relativa robusta para GitHub Pages
const homeUrl = "../../index.html";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{post.data.title} | Algo + que Música y Radio</title>
    <meta name="description" content={post.data.description}>
    <link rel="canonical" href={`https://eliusman.github.io/ALGO-/posts/${post.slug}/`}>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400&family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;700&display=swap');
        
        :root {
            --ink: #1f1c18;
            --muted: #5c564c;
            --accent: #b53a28;
            --card: #d9d2c5;
            --line: #c5b8d4;
        }
        
        * { box-sizing: border-box; }
        
        body {
            margin: 0;
            background-color: #b8a6ce;
            background-image: 
                radial-gradient(ellipse 90% 60% at 15% 15%, rgba(255,255,255,0.28) 0%, transparent 55%),
                radial-gradient(ellipse 70% 50% at 85% 75%, rgba(255,255,255,0.18) 0%, transparent 50%),
                radial-gradient(ellipse 50% 40% at 50% 100%, rgba(140,100,190,0.35) 0%, transparent 60%),
                linear-gradient(160deg, #a894c0 0%, #b8a6ce 35%, #9b85b8 70%, #8a74a8 100%);
            color: var(--ink);
            font-family: "Literata", "Georgia", serif;
            line-height: 1.8;
            padding: 40px 4vw 80px;
            min-height: 100vh;
        }
        
        .back-home {
            display: inline-block;
            margin-bottom: 28px;
            color: var(--accent);
            font-family: "DM Sans", sans-serif;
            font-weight: 700;
            font-size: 0.95rem;
            text-decoration: none;
            transition: opacity 0.2s;
        }
        .back-home:hover {
            opacity: 0.8;
            text-decoration: underline;
        }
        
        .article-container {
            background: var(--card);
            max-width: 860px;
            margin: 0 auto;
            border-radius: 16px;
            padding: 48px 52px;
            border: 1px solid var(--line);
            box-shadow: 
                0 4px 6px rgba(0,0,0,0.05),
                0 16px 48px rgba(0,0,0,0.14);
        }
        
        small {
            color: var(--muted);
            font-family: "DM Sans", sans-serif;
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
        
        h1 {
            font-family: "Space Grotesk", sans-serif;
            font-size: clamp(1.7rem, 3.2vw, 2.3rem);
            margin: 12px 0 28px;
            line-height: 1.25;
            color: var(--ink);
            font-weight: 700;
            letter-spacing: -0.02em;
        }
        
        img {
            max-width: 100%;
            height: auto;
            border-radius: 12px;
            margin: 6px 0 32px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        }
        
        .article-text {
            font-size: 1.13rem;
            color: var(--ink);
            margin-top: 6px;
        }
        
        .article-text p {
            margin: 0 0 1.45em;
        }
        
        .article-text p:last-child {
            margin-bottom: 0;
        }
        
        .article-text strong {
            font-weight: 600;
            color: #15130f;
        }
        
        .article-text blockquote {
            margin: 1.8em 0;
            padding: 0.8em 0 0.8em 1.4em;
            border-left: 4px solid var(--accent);
            font-style: italic;
            color: #2c2822;
            background: rgba(181, 58, 40, 0.07);
            border-radius: 0 8px 8px 0;
        }
        
        .original-link {
            display: inline-block;
            margin-top: 32px;
            color: var(--accent);
            font-family: "DM Sans", sans-serif;
            font-weight: 700;
            font-size: 0.95rem;
            text-decoration: none;
        }
        .original-link:hover {
            text-decoration: underline;
        }
        
        /* Escritorio */
        @media (min-width: 1000px) {
            body {
                padding: 50px 5vw 100px;
            }
            .article-container {
                max-width: 920px;
                padding: 56px 64px;
            }
            .article-text {
                font-size: 1.16rem;
            }
        }
        
        /* Pantallas muy grandes */
        @media (min-width: 1400px) {
            .article-container {
                max-width: 980px;
            }
        }
        
        /* Móvil */
        @media (max-width: 600px) {
            body {
                padding: 24px 4vw 60px;
            }
            .article-container {
                padding: 30px 20px;
                border-radius: 12px;
            }
            .article-text {
                font-size: 1.05rem;
            }
            h1 {
                font-size: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <a class="back-home" href={homeUrl}>← Volver a la página principal</a>
    <main class="article-container">
        <small>{post.data.category}</small>
        <h1>{post.data.title}</h1>
        {post.data.modalImg && <img src={post.data.modalImg} alt={post.data.title} />}
        
        <div class="article-text">
            <Content />
        </div>

        {post.data.videoUrl && (
            <p><a href={post.data.videoUrl} target="_blank" rel="noopener noreferrer" class="original-link">▶ Ver vídeo original en YouTube ➔</a></p>
        )}
    </main>
</body>
</html>
