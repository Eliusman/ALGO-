    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;700&display=swap');
        :root {
            --bg:#f5f2ec;
            --ink:#171717;
            --muted:#6e6a63;
            --accent:#e64b35;
            --blue-btn:#1d4ed8;
            --card:#ffffff;
            --line:#ddd7cc;
            --dark:#171717;
        }
        *{box-sizing:border-box}
        
        p, span, h1, h2, h3, a, li, small {
            word-spacing: normal;
            letter-spacing: normal;
        }

        html{scroll-behavior:smooth}
        body{margin:0;background:var(--bg);color:var(--ink);font-family:"DM Sans",sans-serif;line-height:1.5}
        a{color:inherit;text-decoration:none}

        header{
            min-height:600px;
            color:white;
            padding:20px 7vw 60px;
            background: linear-gradient(rgba(18, 17, 17, 0.45), rgba(26, 14, 14, 0.55)), url("https://i.ibb.co/vvBZYSkQ/radio-vintage-taller-retro.jpg") center/cover no-repeat;
            position: relative;
        }
        header::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 8px;
            background: linear-gradient(90deg, #e64b35, #f59e0b, #10b981, #3b82f6, #8b5cf6, #ec4899);
            z-index: 10;
        }
        nav{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(255,255,255,0.2);padding-bottom:20px;flex-wrap:wrap;gap:20px}
        .logo{font-family:"Space Grotesk",sans-serif;font-size:1.6rem;font-weight:700}
        .logo b{color:var(--accent);font-size:1.8em}
        .menu{display:flex;gap:18px;font-size:.9rem;flex-wrap:wrap;align-items:center;}.menu a{cursor:pointer}.menu a:hover{color:#ff826f}

        #language-section {
            background: linear-gradient(rgba(15, 23, 42, 0.35), rgba(15, 23, 42, 0.45)), url("https://i.ibb.co/qL6DWRWG/Screenshot-2026-09-21-10-58-00-149-com-miui-gallery-edit.jpg") center/cover no-repeat;
            padding: 35px 7vw;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
        }
        #language-section p {
            color: #ffffff;
            font-size: 0.85rem;
            margin: 0;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            text-shadow: 0 2px 6px rgba(0,0,0,0.9);
        }
        #language-tabs {
            display: grid;
            grid-template-columns: repeat(5, auto);
            gap: 6px;
            align-items: center;
            background: rgba(15, 23, 42, 0.75);
            padding: 10px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }
        #language-tabs button {
            background: transparent;
            border: none;
            color: white;
            padding: 6px 12px;
            font-size: 0.78rem;
            font-family: inherit;
            font-weight: 700;
            cursor: pointer;
            border-radius: 4px;
            transition: background 0.2s;
            white-space: nowrap;
            text-align: center;
        }
        #language-tabs button:hover {
            background: rgba(230, 75, 53, 0.8);
        }
        
        .goog-te-banner-frame.skiptranslate { display: none !important; }
        body { top: 0px !important; }
        #google_translate_element { display: none; }

        .hero-container{
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 40px;
            margin-top: 60px;
            flex-wrap: wrap;
        }
        .hero{max-width:600px}
        .tag{font-size:.78rem;font-weight:700;letter-spacing:.14em;margin:0 0 12px;text-transform:uppercase}
        h1,h2,h3{font-family:"Space Grotesk",sans-serif;line-height:1.05}
        h1{font-size:clamp(2.5rem,5vw,5rem);margin:0 0 18px;letter-spacing:-.055em;text-shadow:0 4px 20px rgba(0,0,0,0.6);color: white;}
        h1 span{color:var(--accent)}
        .hero>p:not(.tag){max-width:640px;color:#e8e5df;font-size:1.1rem;text-shadow:0 2px 10px rgba(0,0,0,0.7)}
        .hero-buttons{display:flex;gap:14px;flex-wrap:wrap;margin-top:24px}
        .button{display:inline-block;background:var(--accent);padding:11px 20px;border-radius:4px;font-weight:700;cursor:pointer;color:white;border:none}
        .button.blue{background:var(--blue-btn);color:white;border:none}
        .button.blue:hover{background:#1e40af}
        .button:hover{transform:translateY(-2px)}

        .subscription-top-section {
            background: linear-gradient(rgba(15, 23, 42, 0.90), rgba(15, 23, 42, 0.95)), url("https://i.ibb.co/qL6DWRWG/Screenshot-2026-09-21-10-58-00-149-com-miui-gallery-edit.jpg") center/cover no-repeat;
            color: #ffffff;
            padding: 30px 7vw;
            border-bottom: 6px solid var(--accent);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            box-shadow: inset 0 5px 15px rgba(0,0,0,0.4);
        }
        .subscription-top-content {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .subscription-top-content div h3 {
            margin: 0 0 4px 0;
            font-size: 1.2rem;
            color: #ffffff;
        }
        .subscription-top-content div p {
            margin: 0;
            font-size: 0.9rem;
            color: #cbd5e1;
        }

        .pinned-message-section {
            background: linear-gradient(rgba(15, 23, 42, 0.35), rgba(15, 23, 42, 0.45)), url("https://i.ibb.co/qL6DWRWG/Screenshot-2026-09-21-10-58-00-149-com-miui-gallery-edit.jpg") center/cover no-repeat;
            color: #ffffff;
            padding: 50px 7vw;
            border-bottom: 6px solid var(--accent);
            position: relative;
            box-shadow: inset 0 10px 20px rgba(0,0,0,0.3);
        }
        .pinned-content {
            max-width: 800px;
            margin: 0;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 35px 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
            position: relative;
        }
        .pinned-badge {
            display: inline-block;
            background: var(--accent);
            color: white;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            padding: 4px 10px;
            border-radius: 4px;
            margin-bottom: 15px;
        }
        .pinned-content h2 {
            font-size: clamp(1.8rem, 3vw, 2.3rem);
            margin: 0 0 15px 0;
            color: #ffffff;
            text-shadow: 0 2px 6px rgba(0,0,0,0.8);
        }
        .pinned-content p {
            font-size: 1.05rem;
            line-height: 1.6;
            color: #e2e8f0;
            margin: 0 0 15px 0;
            text-shadow: 0 1px 3px rgba(0,0,0,0.6);
        }
        .pinned-content p:last-child {
            margin-bottom: 0;
        }

        .section {
            display: block;
            padding: 70px 7vw;
            border-bottom: none;
            box-shadow: inset 0 -6px 12px -4px rgba(0, 0, 0, 0.25);
            position: relative;
            overflow: hidden;
        }
        .section::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 8px;
            background: linear-gradient(90deg, #e64b35, #f59e0b, #10b981, #3b82f6, #8b5cf6, #ec4899);
            z-index: 10;
        }
        .section::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; z-index: 0;
            background-image: radial-gradient(circle at 25% 25%, rgba(0,0,0,0.35) 0%, transparent 65%), radial-gradient(circle at 75% 75%, rgba(255,255,255,0.55) 0%, transparent 55%), repeating-radial-gradient(circle at 0 0, transparent 0, rgba(0,0,0,0.18) 3px, transparent 6px), repeating-linear-gradient(45deg, rgba(255,255,255,0.08) 0px, rgba(0,0,0,0.14) 3px, transparent 6px);
            background-size: 100% 100%, 100% 100%, 12px 12px, 18px 18px;
            background-blend-mode: multiply, screen, normal, overlay;
            opacity: 0.95;
        }
        .section > * { position: relative; z-index: 1; }

        #lugares {
            background: linear-gradient(rgba(10, 10, 15, 0.65), rgba(15, 15, 20, 0.75)), url("https://i.ibb.co/21N9X8rS/Memoria.jpg") center/cover no-repeat;
            color: #ffffff;
        }
        #lugares::before { display: none; }
        #poolCanvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
        .water-content { position: relative; z-index: 1; }
        #lugares h2, #lugares .tag { color: #ffffff; text-shadow: 0 2px 6px rgba(0,0,0,0.9); font-weight: 800; }

        .load-more-container { width: 100%; margin-top: 20px; text-align: left; }
        .btn-archive {
            background: rgba(255,255,255,0.8);
            border: 2px dashed rgba(0,0,0,0.2);
            color: var(--ink);
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-archive:hover { background: var(--ink); color: #ffffff; border-color: var(--ink); }

        .grid{
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
        }
        .post{
            background: var(--card);
            border:1px solid rgba(0,0,0,0.08);
            border-radius:8px;
            overflow:hidden;
            display:flex;
            flex-direction:column;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
            transition: box-shadow 0.3s ease;
        }
        .post.highlight-post {
            box-shadow: 0 0 25px var(--accent);
            border: 2px solid var(--accent);
        }
        .post.hidden-archive { display: none; }
        
        .cover{
            height: 180px;
            background:#111;
            display:grid;
            place-items:center;
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center top 20%;
        }
        
        .content{padding:20px;display:flex;flex-direction:column;flex-grow:1}
        .content small{color:var(--muted);font-size:.72rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}
        h3{font-size:1.2rem;margin:6px 0 8px;line-height:1.2;color:var(--ink)}
        .content p{
            color:var(--muted);
            font-size:.9rem;
            line-height:1.4;
            margin:0 0 14px;
        }
        
        .content .original-link, 
        .article-text a {
            display: inline-block;
            margin-top: 8px;
            font-size: 0.88rem;
            color: var(--accent) !important;
            font-weight: 700;
            text-decoration: none;
        }
        .content .original-link:hover, 
        .article-text a:hover {
            text-decoration: underline;
            color: #ff6b52 !important;
        }

        #archivo-search {
            display: block;
            background: #ffffff;
            padding: 30px 7vw;
            border-bottom: none;
            box-shadow: inset 0 -6px 12px -4px rgba(0, 0, 0, 0.25);
            position: relative;
        }
        #archivo-search::after {
            content: "";
            position: absolute;
            bottom: 0; left: 0; width: 100%; height: 8px;
            background: linear-gradient(90deg, #e64b35, #f59e0b, #10b981, #3b82f6, #8b5cf6, #ec4899);
            z-index: 10;
        }
        .search-box { display: flex; gap: 15px; flex-wrap: wrap; margin-top: 15px; }
        .search-input {
            flex: 1;
            min-width: 200px;
            padding: 10px 15px;
            border: 1px solid var(--line);
            border-radius: 6px;
            font-family: inherit;
            font-size: 0.95rem;
        }

        #pensamientos {
            background: linear-gradient(rgba(0, 0, 0, 0.30), rgba(0, 0, 0, 0.45)), url("https://i.ibb.co/DPDKnFFb/Pensamientos.jpg") center/cover no-repeat;
            color: #ffffff;
        }
        #pensamientos::before { display: none; }
        #pensamientos h2, #pensamientos .tag {
            color: #ffffff;
            text-shadow: 0 2px 6px rgba(0,0,0,0.9);
            font-weight: 800;
        }

        #musica {
            background: linear-gradient(rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.25)), url("https://i.ibb.co/ksXkRyxZ/Reproductores-musicales.jpg") center/cover no-repeat;
            color: #ffffff;
        }
        #musica::before { display: none; }
        #musica h2, #musica .tag {
            color: #ffffff;
            text-shadow: 0 2px 6px rgba(0,0,0,0.9);
            font-weight: 800;
        }

        #delantal {
            background: linear-gradient(rgba(0, 0, 0, 0.30), rgba(0, 0, 0, 0.45)), url("https://i.ibb.co/KpZC18QR/Delantales-fiesta.png") center/cover no-repeat;
            color: #ffffff;
        }
        #delantal::before { display: none; }
        #delantal h2, #delantal .tag {
            color: #ffffff;
            text-shadow: 0 2px 6px rgba(0,0,0,0.9);
            font-weight: 800;
        }

        #sabias {
            background: linear-gradient(rgba(0, 0, 0, 0.30), rgba(0, 0, 0, 0.45)), url("https://i.ibb.co/sJXM5RPW/Sabias-esto.jpg") center/cover no-repeat;
            color: #ffffff;
        }
        #sabias::before { display: none; }
        #sabias h2, #sabias .tag {
            color: #ffffff;
            text-shadow: 0 2px 6px rgba(0,0,0,0.9);
            font-weight: 800;
        }

        #sinpermiso {
            background: linear-gradient(rgba(0, 0, 0, 0.30), rgba(0, 0, 0, 0.45)), url("https://i.ibb.co/Q7r80zqB/Que-canci-n-es.jpg") center/cover no-repeat;
            color: #ffffff;
        }
        #sinpermiso::before { display: none; }
        #sinpermiso h2, #sinpermiso .tag {
            color: #ffffff;
            text-shadow: 0 2px 6px rgba(0,0,0,0.9);
            font-weight: 800;
        }

        #ciencia { 
            background-color: #000000; 
            color: #ffffff; 
            position: relative; 
            overflow: hidden; 
            padding: 70px 7vw;
            min-height: 650px;
        }
        #ciencia::before { display: none; }
        #earthCanvas { 
            position: absolute; 
            top: 0; 
            left: 0; 
            width: 100%; 
            height: 100%; 
            z-index: 0; 
            pointer-events: none; 
        }
        .ciencia-content { 
            position: relative; 
            z-index: 1; 
            width: 100%;
        }
        #ciencia h2, #ciencia .tag { 
            color: #ffffff; 
            text-shadow: 0 2px 8px rgba(0,0,0,0.95); 
            font-weight: 800; 
        }
        #ciencia .tag {
            font-size: 0.85rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            opacity: 0.85;
            margin-bottom: 0.4rem;
        }
        #ciencia h2 {
            font-family: "Space Grotesk", sans-serif;
            font-size: clamp(2.4rem, 5vw, 3.4rem);
            margin: 0 0 1.8rem 0;
            line-height: 1.1;
        }

        #estrellas {
            background: linear-gradient(rgba(0, 0, 0, 0.30), rgba(0, 0, 0, 0.45)), url("https://i.ibb.co/H1xgMHD/terrenales-y-celestiales.jpg") center/cover no-repeat;
            color: #ffffff;
        }
        #estrellas::before { display: none; }
        #estrellas h2, #estrellas .tag {
            color: #ffffff;
            text-shadow: 0 2px 6px rgba(0,0,0,0.9);
            font-weight: 800;
        }

        .about{
            display: block;
            padding:80px 7vw;color:#ffffff;position:relative;overflow:hidden;background:transparent;
        }
        #cosmosCanvas{position:absolute;top:0;left:0;width:100%;height:100%;z-index:1}
        .about-content{position:relative;z-index:2}

        .modal-overlay{
            position:fixed;top:0;left:0;width:100%;height:100%;
            background:rgba(0,0,0,0.75);display:none;justify-content:center;align-items:center;
            z-index:1000;padding:20px;backdrop-filter:blur(4px);
        }
        .modal-content{
            background:var(--card);max-width:750px;width:100%;max-height:85vh;
            overflow-y:auto;border-radius:12px;padding:35px;position:relative;
            border:1px solid var(--line);box-shadow:0 20px 40px rgba(0,0,0,0.3);
        }
        .modal-close{
            position:absolute;top:15px;right:20px;font-size:1.8rem;cursor:pointer;
            color:var(--muted);background:none;border:none;line-height:1;
        }
        .article-text{font-size:1rem;line-height:1.7;color:var(--ink);margin-top:15px}

        .visit-counter{
            display:inline-flex;align-items:center;gap:8px;font-size:.8rem;
            color:var(--muted);background:rgba(0,0,0,0.04);padding:6px 14px;
            border-radius:20px;border:1px solid var(--line);
        }
        .visit-counter span{font-weight:700;color:var(--ink)}

        footer{
            display:flex;justify-content:space-between;align-items:center;
            padding:30px 7vw;font-size:.85rem;background:#0f172a;color:#94a3b8;
            flex-wrap:wrap;gap:15px;
        }

        .cover.musica-new{ background-image: linear-gradient(rgba(0,0,0,.15),rgba(0,0,0,.3)), url("https://i.ytimg.com/vi/rYNW1IxaFf4/hqdefault.jpg"); background-position: center top 20%; }
        .cover.wangok-cover{ background-image: linear-gradient(rgba(0,0,0,.15),rgba(0,0,0,.3)), url("https://img.youtube.com/vi/orqjiuJWiF8/hqdefault.jpg"); background-position: center center; }
        .cover.rumba-catalana-cover{ background-image: linear-gradient(rgba(0,0,0,.15),rgba(0,0,0,.3)), url("https://img.youtube.com/vi/PUSSbuGhNnQ/hqdefault.jpg"); background-position: center center; }
        .cover.lugares-new{ background-image: linear-gradient(rgba(0,0,0,.15),rgba(0,0,0,.3)), url("https://i.ibb.co/mVzHwNPw/1789482567467.png"); background-position: center top 15%; }
        .cover.pensamientos-new{ background-image: linear-gradient(rgba(0,0,0,.15),rgba(0,0,0,.3)), url("https://i.ibb.co/hFCrqLDK/Pensamientos.png"); background-position: center top 20%; }
        .cover.pensamientos-acordeon-cover { background-image: linear-gradient(rgba(0,0,0,.15),rgba(0,0,0,.3)), url("https://i.ibb.co/nsf8Q0Qf/Acorde-n.jpg"); background-position: center center; }
        .cover.ciencia-new{ background-image: linear-gradient(rgba(0,0,0,.15),rgba(0,0,0,.3)), url("https://i.ibb.co/wFFPqdtL/Domimio-p-blico-Carl-Sagan.jpg"); background-position: center top 10%; }
