        /* === CALENDARIO 3D VIBRANTE Y MODERNO === */
        .hero-calendar-card {
            position: relative;
            overflow: hidden;
            perspective: 1100px;
            transform-style: preserve-3d;
            background: linear-gradient(135deg, rgba(31,27,72,.98), rgba(54,28,104,.96) 48%, rgba(12,67,111,.96));
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 28px 70px rgba(45,20,95,.34), inset 0 1px 0 rgba(255,255,255,.18);
            max-width: 320px;
            width: 100%;
        }
        .hero-calendar-card::before {
            content: "";
            position: absolute;
            inset: -2px;
            pointer-events: none;
            background: radial-gradient(circle at 8% 8%, rgba(255,71,160,.28), transparent 28%), radial-gradient(circle at 92% 12%, rgba(0,229,255,.25), transparent 27%), radial-gradient(circle at 50% 100%, rgba(139,92,246,.28), transparent 34%);
        }
        .calendar-header {
            position: relative;
            z-index: 2;
            padding: 12px 4px 15px;
            margin-bottom: 8px;
            text-shadow: 0 2px 4px rgba(0,0,0,.8);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: "Space Grotesk", sans-serif;
            font-weight: 700;
            font-size: 0.95rem;
            color: white;
            border-bottom: 1px solid rgba(255,255,255,.10);
        }
        .cal-nav-btn {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: linear-gradient(145deg, #ff4fa3, #8b5cf6 55%, #4f46e5);
            box-shadow: 0 7px 16px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.22);
            border: 1px solid rgba(255,255,255,.20);
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            transition: transform .2s ease, box-shadow .2s ease;
        }
        .cal-nav-btn:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 12px 22px rgba(0,0,0,.28), 0 0 18px rgba(96,180,255,.14);
        }
        .calendar-grid {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 7px;
            text-align: center;
            font-size: 0.8rem;
            padding: 4px 2px 10px;
        }
        .calendar-day-head {
            padding-bottom: 7px;
            color: #ff9b8c;
            font-weight: 800;
            font-size: .68rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            opacity: .72;
            text-shadow: 0 2px 4px rgba(0,0,0,.7);
        }
        .calendar-day {
            position: relative;
            min-height: 44px;
            display: grid;
            place-items: center;
            padding: 5px 0;
            border-radius: 13px;
            background: linear-gradient(145deg, rgba(255,255,255,.16), rgba(255,255,255,.055));
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,.13);
            box-shadow: 0 7px 13px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.13);
            text-shadow: 0 2px 3px rgba(0,0,0,.8);
            color: #fff;
            font-size: 0.78rem;
            transition: transform .22s cubic-bezier(.2,.8,.2,1), box-shadow .22s ease, border-color .22s ease;
        }
        .calendar-day:hover:not(.empty) {
            transform: translateY(-5px) scale(1.035);
            border-color: rgba(255,255,255,.28);
            box-shadow: 0 15px 26px rgba(0,0,0,.30), 0 0 20px rgba(96,180,255,.10);
            z-index: 5;
        }
        .calendar-day.empty {
            background: transparent;
            border-color: transparent;
            box-shadow: none;
        }
        :global(.hero-calendar-card .calendar-day.past-post) {
            background: linear-gradient(145deg, #00b8d9, #2563eb 55%, #4f46e5) !important;
            border-color: rgba(105,198,255,.38) !important;
            box-shadow: 0 9px 18px rgba(0,62,125,.28), inset 0 1px 0 rgba(255,255,255,.22) !important;
            cursor: pointer;
            font-weight: 700;
        }
        :global(.hero-calendar-card .calendar-day.latest-post) {
            background: linear-gradient(145deg, #ff3d81, #ff7a18 52%, #facc15) !important;
            border-color: rgba(255,218,190,.62) !important;
            box-shadow: 0 10px 24px rgba(180,45,38,.35), 0 0 24px rgba(255,98,67,.18), inset 0 1px 0 rgba(255,255,255,.30) !important;
            cursor: pointer;
            font-weight: 700;
        }
        :global(.hero-calendar-card .calendar-day.latest-post::after) {
            content: '';
            position: absolute;
            top: 6px;
            right: 7px;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(255,255,255,.92);
            box-shadow: 0 0 10px rgba(255,255,255,.85);
        }
        :global(.hero-calendar-card .calendar-day.today) {
            background: linear-gradient(145deg, #39f27a 0%, #12b957 52%, #087f3d 100%) !important;
            border-color: rgba(180,255,204,.95) !important;
            color: #ffffff !important;
            box-shadow: 5px 6px 14px rgba(0,0,0,.42), inset 1px 1px 0 rgba(255,255,255,.38), 0 0 20px rgba(34,197,94,.75) !important;
            text-shadow: 0 2px 4px rgba(0,80,35,.75) !important;
        }
        .calendar-legend {
            position: relative;
            z-index: 2;
            margin-top: 10px;
            padding-top: 12px;
            border-top: 1px solid rgba(255,255,255,.10);
            text-shadow: 0 1px 3px rgba(0,0,0,.8);
