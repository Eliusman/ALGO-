            background: linear-gradient(145deg, rgba(255,255,255,.38), rgba(255,255,255,.12));
            transform: translateZ(18px) translateY(-2px);
        }
        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 6px;
            text-align: center;
            font-size: 0.8rem;
        }
        .calendar-day-head {
            padding-bottom: 7px;
            color: #ff9b8c;
            font-weight: 700;
            font-size: 0.7rem;
            text-shadow: 0 2px 4px rgba(0,0,0,.7);
