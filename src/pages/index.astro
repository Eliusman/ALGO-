        .calendar-day {
            position: relative;
            min-height: 34px;
            display: grid;
            place-items: center;
            padding: 5px 0;
            border-radius: 9px;
            background: linear-gradient(145deg, rgba(255,255,255,.16), rgba(0,0,0,.28));
            border: 1px solid rgba(255,255,255,.10);
