    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;700&display=swap');
        :root {
            --bg:#f5f2ec;
            --ink:#171717;
            --muted:#6e6a63;
            --accent:#e64b35;
            --blue-btn:#1d4ed8;
            --card:#ffffff;
            --line:#ddd7cc;
            --dark:#171717;
        }
        *{box-sizing:border-box}
        
        p, span, h1, h2, h3, a, li, small {
            word-spacing: normal;
            letter-spacing: normal;
        }

        html{scroll-behavior:smooth}
        body{margin:0;background:var(--bg);color:var(--ink);font-family:"DM Sans",sans-serif;line-height:1.5}
        a{color:inherit;text-decoration:none}

        header{
            min-height:600px;
            color:white;
            padding:20px 7vw 60px;
            background: linear-gradient(rgba(18, 17, 17, 0.45), rgba(26, 14, 14, 0.55)), url("https://i.ibb.co/vvBZYSkQ/radio-vintage-taller-retro.jpg") center/cover no-repeat;
            position: relative;
        }
        header::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 8px;
            background: linear-gradient(90deg, #e64b35, #f59e0b, #10b981, #3b82f6, #8b5cf6, #ec4899);
            z-index: 10;
        }
        nav{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(255,255,255,0.2);padding-bottom:20px;flex-wrap:wrap;gap:20px}
        .logo{font-family:"Space Grotesk",sans-serif;font-size:1.6rem;font-weight:700}
        .logo b{color:var(--accent);font-size:1.8em}
        .menu{display:flex;gap:18px;font-size:.9rem;flex-wrap:wrap;align-items:center;}.menu a{cursor:pointer}.menu a:hover{color:#ff826f}

        #language-section {
            background: linear-gradient(rgba(15, 23, 42, 0.35), rgba(15, 23, 42, 0.45)), url("https://i.ibb.co/qL6DWRWG/Screenshot-2026-09-21-10-58-00-149-com-miui-gallery-edit.jpg") center/cover no-repeat;
            padding: 35px 7vw;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
        }
        #language-section p {
            color: #ffffff;
            font-size: 0.85rem;
            margin: 0;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            text-shadow: 0 2px 6px rgba(0,0,0,0.9);
        }
        #language-tabs {
            display: grid;
            grid-template-columns: repeat(5, auto);
            gap: 6px;
            align-items: center;
            background: rgba(15, 23, 42, 0.75);
            padding: 10px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }
        #language-tabs button {
            background: transparent;
            border: none;
            color: white;
            padding: 6px 12px;
            font-size: 0.78rem;
            font-family: inherit;
            font-weight: 700;
            cursor: pointer;
            border-radius: 4px;
            transition: background 0.2s;
            white-space: nowrap;
            text-align: center;
        }
        #language-tabs button:hover {
            background: rgba(230, 75, 53, 0.8);
        }
        
        .goog-te-banner-frame.skiptranslate { display: none !important; }
        body { top: 0px !important; }
        #google_translate_element { display: none; }

        .hero-container{
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 40px;
            margin-top: 60px;
            flex-wrap: wrap;
        }
        .hero{max-width:600px}
        .tag{font-size:.78rem;font-weight:700;letter-spacing:.14em;margin:0 0 12px;text-transform:uppercase}
        h1,h2,h3{font-family:"Space Grotesk",sans-serif;line-height:1.05}
        h1{font-size:clamp(2.5rem,5vw,5rem);margin:0 0 18px;letter-spacing:-.055em;text-shadow:0 4px 20px rgba(0,0,0,0.6);color: white;}
        h1 span{color:var(--accent)}
        .hero>p:not(.tag){max-width:640px;color:#e8e5df;font-size:1.1rem;text-shadow:0 2px 10px rgba(0,0,0,0.7)}
        .hero-buttons{display:flex;gap:14px;flex-wrap:wrap;margin-top:24px}
        .button{display:inline-block;background:var(--accent);padding:11px 20px;border-radius:4px;font-weight:700;cursor:pointer;color:white;border:none}
        .button.blue{background:var(--blue-btn);color:white;border:none}
        .button.blue:hover{background:#1e40af}
        .button:hover{transform:translateY(-2px)}

        .subscription-top-section {
            background: linear-gradient(rgba(15, 23, 42, 0.90), rgba(15, 23, 42, 0.95)), url("https://i.ibb.co/qL6DWRWG/Screenshot-2026-09-21-10-58-00-149-com-miui-gallery-edit.jpg") center/cover no-repeat;
            color: #ffffff;
            padding: 30px 7vw;
            border-bottom: 6px solid var(--accent);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            box-shadow: inset 0 5px 15px rgba(0,0,0,0.4);
        }
        .subscription-top-content {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .subscription-top-content div h3 {
            margin: 0 0 4px 0;
            font-size: 1.2rem;
            color: #ffffff;
        }
        .subscription-top-content div p {
            margin: 0;
            font-size: 0.9rem;
            color: #cbd5e1;
        }

        .pinned-message-section {
            background: linear-gradient(rgba(15, 23, 42, 0.35), rgba(15, 23, 42, 0.45)), url("https://i.ibb.co/qL6DWRWG/Screenshot-2026-09-21-10-58-00-149-com-miui-gallery-edit.jpg") center/cover no-repeat;
            color: #ffffff;
            padding: 50px 7vw;
            border-bottom: 6px solid var(--accent);
            position: relative;
            box-shadow: inset 0 10px 20px rgba(0,0,0,0.3);
        }
        .pinned-content {
            max-width: 800px;
            margin: 0;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 35px 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
            position: relative;
        }
        .pinned-badge {
            display: inline-block;
            background: var(--accent);
            color: white;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            padding: 4px 10px;
            border-radius: 4px;
            margin-bottom: 15px;
        }
        .pinned-content h2 {
            font-size: clamp(1.8rem, 3vw, 2.3rem);
            margin: 0 0 15px 0;
            color: #ffffff;
            text-shadow: 0 2px 6px rgba(0,0,0,0.8);
        }
        .pinned-content p {
            font-size: 1.05rem;
            line-height: 1.6;
            color: #e2e8f0;
            margin: 0 0 15px 0;
            text-shadow: 0 1px 3px rgba(0,0,0,0.6);
        }
        .pinned-content p:last-child {
            margin-bottom: 0;
        }

        /* === CALENDARIO 3D VIBRANTE Y MODERNO === */
        .hero-calendar-card {
            position: relative;
            overflow: hidden;
            perspective: 1100px;
            transform-style: preserve-3d;
            background: linear-gradient(135deg, rgba(31,27,72,.98), rgba(54,28,104,.96) 48%, rgba(12,67,111,.96));
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 28px 70px rgba(45,20,95,.34), inset 0 1px 0 rgba(255,255,255,.18);
            max-width: 320px;
            width: 100%;
        }
        .hero-calendar-card::before {
            content: "";
            position: absolute;
            inset: -2px;
            pointer-events: none;
            background: radial-gradient(circle at 8% 8%, rgba(255,71,160,.28), transparent 28%), radial-gradient(circle at 92% 12%, rgba(0,229,255,.25), transparent 27%), radial-gradient(circle at 50% 100%, rgba(139,92,246,.28), transparent 34%);
        }
        .calendar-header {
            position: relative;
            z-index: 2;
            padding: 12px 4px 15px;
            margin-bottom: 8px;
            text-shadow: 0 2px 4px rgba(0,0,0,.8);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: "Space Grotesk", sans-serif;
            font-weight: 700;
            font-size: 0.95rem;
            color: white;
            border-bottom: 1px solid rgba(255,255,255,.10);
        }
        .cal-nav-btn {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: linear-gradient(145deg, #ff4fa3, #8b5cf6 55%, #4f46e5);
            box-shadow: 0 7px 16px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.22);
            border: 1px solid rgba(255,255,255,.20);
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            transition: transform .2s ease, box-shadow .2s ease;
        }
        .cal-nav-btn:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 12px 22px rgba(0,0,0,.28), 0 0 18px rgba(96,180,255,.14);
        }
        .calendar-grid {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 7px;
            text-align: center;
            font-size: 0.8rem;
            padding: 4px 2px 10px;
        }
        .calendar-day-head {
            padding-bottom: 7px;
            color: #ff9b8c;
            font-weight: 800;
            font-size: .68rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            opacity: .72;
            text-shadow: 0 2px 4px rgba(0,0,0,.7);
        }
        .calendar-day {
            position: relative;
            min-height: 44px;
            display: grid;
            place-items: center;
            padding: 5px 0;
            border-radius: 13px;
            background: linear-gradient(145deg, rgba(255,255,255,.16), rgba(255,255,255,.055));
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,.13);
            box-shadow: 0 7px 13px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.13);
            text-shadow: 0 2px 3px rgba(0,0,0,.8);
            color: #fff;
            font-size: 0.78rem;
            transition: transform .22s cubic-bezier(.2,.8,.2,1), box-shadow .22s ease, border-color .22s ease;
        }
        .calendar-day:hover:not(.empty) {
            transform: translateY(-5px) scale(1.035);
            border-color: rgba(255,255,255,.28);
            box-shadow: 0 15px 26px rgba(0,0,0,.30), 0 0 20px rgba(96,180,255,.10);
            z-index: 5;
        }
        .calendar-day.empty {
            background: transparent;
            border-color: transparent;
            box-shadow: none;
        }
        :global(.hero-calendar-card .calendar-day.past-post) {
            background: linear-gradient(145deg, #00b8d9, #2563eb 55%, #4f46e5) !important;
            border-color: rgba(105,198,255,.38) !important;
            box-shadow: 0 9px 18px rgba(0,62,125,.28), inset 0 1px 0 rgba(255,255,255,.22) !important;
            cursor: pointer;
            font-weight: 700;
        }
        :global(.hero-calendar-card .calendar-day.latest-post) {
            background: linear-gradient(145deg, #ff3d81, #ff7a18 52%, #facc15) !important;
            border-color: rgba(255,218,190,.62) !important;
            box-shadow: 0 10px 24px rgba(180,45,38,.35), 0 0 24px rgba(255,98,67,.18), inset 0 1px 0 rgba(255,255,255,.30) !important;
            cursor: pointer;
            font-weight: 700;
        }
        :global(.hero-calendar-card .calendar-day.latest-post::after) {
            content: '';
            position: absolute;
            top: 6px;
            right: 7px;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(255,255,255,.92);
            box-shadow: 0 0 10px rgba(255,255,255,.85);
        }
        :global(.hero-calendar-card .calendar-day.today) {
            background: linear-gradient(145deg, #39f27a 0%, #12b957 52%, #087f3d 100%) !important;
            border-color: rgba(180,255,204,.95) !important;
            color: #ffffff !important;
            box-shadow: 5px 6px 14px rgba(0,0,0,.42), inset 1px 1px 0 rgba(255,255,255,.38), 0 0 20px rgba(34,197,94,.75) !important;
            text-shadow: 0 2px 4px rgba(0,80,35,.75) !important;
        }
        .calendar-legend {
            position: relative;
            z-index: 2;
            margin-top: 10px;
            padding-top: 12px;
            border-top: 1px solid rgba(255,255,255,.10);
            text-shadow: 0 1px 3px rgba(0,0,0,.8);
            font-size: 0.7rem;
            display: flex;
            flex-direction: column;
            gap: 4px;
            color: #ffffff;
        }
        .legend-item { display: flex; align-items: center; gap: 8px; }
        .calendar-legend-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; box-shadow: 0 3px 8px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.35); }
        .calendar-legend-dot.latest { background: linear-gradient(145deg, #ff3d81, #ff7a18); }
        .calendar-legend-dot.past { background: linear-gradient(145deg, #00b8d9, #2563eb); }
        .calendar-legend-dot.today { background: linear-gradient(145deg, #39f27a, #12b957); }

        .ambient-widget-box {
            position: relative;
            z-index: 2;
            margin-top: 14px;
            border-radius: 11px;
            background: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 8px 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .ambient-widget-info {
            font-size: 0.73rem;
            color: #fff;
            font-family: sans-serif;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .ambient-play-btn {
            background: var(--accent);
            border: none;
            color: white;
            border-radius: 50%;
            width: 26px;
            height: 26px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 0.75rem;
            transition: transform 0.2s;
        }
        .ambient-play-btn:hover { transform: scale(1.1); }

        .section {
            display: block;
            padding: 70px 7vw;
            border-bottom: none;
            box-shadow: inset 0 -6px 12px -4px rgba(0, 0, 0, 0.25);
            position: relative;
            overflow: hidden;
        }
        .section::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 8px;
            background: linear-gradient(90deg, #e64b35, #f59e0b, #10b981, #3b82f6, #8b5cf6, #ec4899);
            z-index: 10;
        }
        .section::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; z-index: 0;
            background-image: radial-gradient(circle at 25% 25%, rgba(0,0,0,0.35) 0%, transparent 65%), radial-gradient(circle at 75% 75%, rgba(255,255,255,0.55) 0%, transparent 55%), repeating-radial-gradient(circle at 0 0, transparent 0, rgba(0,0,0,0.18) 3px, transparent 6px), repeating-linear-gradient(45deg, rgba(255,255,255,0.08) 0px, rgba(0,0,0,0.14) 3px, transparent 6px);
            background-size: 100% 100%, 100% 100%, 12px 12px, 18px 18px;
            background-blend-mode: multiply, screen, normal, overlay;
            opacity: 0.95;
        }
        .section > * { position: relative; z-index: 1; }

        #lugares {
            background: linear-gradient(rgba(10, 10, 15, 0.65), rgba(15, 15, 20, 0.75)), url("https://i.ibb.co/21N9X8rS/Memoria.jpg") center/cover no-repeat;
            color: #ffffff;
            position: relative;
            overflow: hidden;
        }
        #lugares::before { display: none; }
        #poolCanvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
        .water-content { position: relative; z-index: 1; }
        #lugares h2, #lugares .tag { color: #ffffff; text-shadow: 0 2px 6px rgba(0,0,0,0.9); font-weight: 800; }

        .load-more-container { width: 100%; margin-top: 20px; text-align: left; }
        .btn-archive {
            background: rgba(255,255,255,0.8);
            border: 2px dashed rgba(0,0,0,0.2);
            color: var(--ink);
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-archive:hover { background: var(--ink); color: #ffffff; border-color: var(--ink); }

        .grid{
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
        }
        .post{
            background: var(--card);
            border:1px solid rgba(0,0,0,0.08);
            border-radius:8px;
            overflow:hidden;
            display:flex;
            flex-direction:column;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
            transition: box-shadow 0.3s ease;
        }
        .post.highlight-post {
            box-shadow: 0 0 25px var(--accent);
            border: 2px solid var(--accent);
        }
        .post.hidden-archive { display: none; }
        
        .cover{
            height: 180px;
            background:#111;
            display:grid;
            place-items:center;
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center top 20%;
        }
        
        .content{padding:20px;display:flex;flex-direction:column;flex-grow:1}
        .content small{color:var(--muted);font-size:.72rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}
        h3{font-size:1.2rem;margin:6px 0 8px;line-height:1.2;color:var(--ink)}
        .content p{
            color:var(--muted);
            font-size:.9rem;
            line-height:1.4;
            margin:0 0 14px;
        }
        .content a, .content button{
            color:var(--accent);
            font-weight:700;
            margin-top:auto;
            display:inline-block;
            background:none;
            border:none;
            padding:0;
            font-size:.9rem;
            font-family:inherit;
            cursor:pointer;
            text-align:left;
        }
        
        .content .original-link, 
        .article-text a {
            display: inline-block;
            margin-top: 8px;
            font-size: 0.88rem;
            color: var(--accent) !important;
            font-weight: 700;
            text-decoration: none;
        }
        .content .original-link:hover, 
        .article-text a:hover {
            text-decoration: underline;
            color: #ff6b52 !important;
        }

        #archivo-search {
            display: block;
            background: #ffffff;
            padding: 30px 7vw;
            border-bottom: none;
            box-shadow: inset 0 -6px 12px -4px rgba(0, 0, 0, 0.25);
            position: relative;
        }
        #archivo-search::after {
            content: "";
            position: absolute;
            bottom: 0; left: 0; width: 100%; height: 8px;
            background: linear-gradient(90deg, #e64b35, #f59e0b, #10b981, #3b82f6, #8b5cf6, #ec4899);
