        var currentCalDate = new Date(2026, 9, 1);
        var monthNames = [
            "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
            "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
        ];

        function renderCalendar() {
            var year = currentCalDate.getFullYear();
            var month = currentCalDate.getMonth();
            var calTitle = document.getElementById('calMonthTitle');
            if (calTitle) calTitle.innerText = monthNames[month] + " " + year;
            
            var container = document.getElementById('calendarDays');
            if (!container) return;
            container.innerHTML = '';
            
            var firstDayIndex = new Date(year, month, 1).getDay();
            firstDayIndex = (firstDayIndex === 0) ? 6 : firstDayIndex - 1;
            
            var totalDays = new Date(year, month + 1, 0).getDate();
            var postDates = Object.keys(publishedPosts);
            var latestDateKey = postDates.length > 0 ? postDates.reduce(function(latest, current) { return current > latest ? current : latest; }) : null;
            
            for (var i = 0; i < firstDayIndex; i++) {
                var emptyDiv = document.createElement('div');
                emptyDiv.className = 'calendar-day empty';
                container.appendChild(emptyDiv);
            }
            
            for (var day = 1; day <= totalDays; day++) {
                (function(d) {
                    var dayDiv = document.createElement('div');
                    dayDiv.className = 'calendar-day';
                    dayDiv.innerText = d;
                    
                    var formattedMonth = String(month + 1).padStart(2, '0');
                    var formattedDay = String(d).padStart(2, '0');
                    var dateKey = year + '-' + formattedMonth + '-' + formattedDay;
                    
                    var hasPost = false;
                    if (publishedPosts[dateKey]) {
                        hasPost = true;
                        var postInfo = publishedPosts[dateKey];
                        var isLatest = (dateKey === latestDateKey);
                        
                        if (isLatest) {
                            dayDiv.classList.add('latest-post');
                            dayDiv.title = 'Ir a la última publicación';
                        } else {
                            dayDiv.classList.add('past-post');
                            dayDiv.title = 'Ir a la publicación';
                        }
                        dayDiv.onclick = function() { goToArticle(postInfo.id); };
                    }

                    var today = new Date();
                    var todayKey = today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0');
                    if (dateKey === todayKey && !hasPost) {
                        dayDiv.classList.add('today');
                        dayDiv.title = 'Hoy';
                    }

                    container.appendChild(dayDiv);
                })(day);
            }
        }

        function goToArticle(articleId) {
            var articleElement = document.getElementById('post-' + articleId);
            if (!articleElement) return;

            if (articleElement.classList.contains('hidden-archive')) {
                articleElement.classList.remove('hidden-archive');
                articleElement.style.display = 'flex';
                // Buscar el botón de ver histórico de su sección para sincronizar su texto si está abierto
                var grid = articleElement.closest('.grid');
                if (grid) {
                    var section = grid.closest('section');
                    if (section) {
                        var btn = section.querySelector('.btn-archive');
                        if (btn) {
                            btn.setAttribute('data-expanded', 'true');
                            btn.innerText = 'Ocultar histórico';
                        }
                    }
                }
            }

            articleElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
            articleElement.classList.add('highlight-post');
            setTimeout(function() {
                articleElement.classList.remove('highlight-post');
            }, 2000);
        }

        function goToLatestPost() {
            var allPosts = document.querySelectorAll('.post');
            var latestPost = null;
            var latestDate = '';

            allPosts.forEach(function(post) {
                var postDate = post.getAttribute('data-datetime') || '';
                if (postDate > latestDate) {
                    latestDate = postDate;
                    latestPost = post;
                }
            });

            if (latestPost && latestPost.id) {
                var articleId = latestPost.id.replace('post-', '');
                goToArticle(articleId);
            }
        }

        function toggleArchive(gridId, btn) {
            var grid = document.getElementById(gridId);
            if (!grid) return;
            var hiddenPosts = grid.querySelectorAll('.post.hidden-archive');
            var isExpanded = btn.getAttribute('data-expanded') === 'true';
            
            if (isExpanded) {
                hiddenPosts.forEach(function(post) { post.style.display = 'none'; });
                btn.setAttribute('data-expanded', 'false');
                btn.innerText = 'Ver artículos en histórico (+' + hiddenPosts.length + ')';
            } else {
                hiddenPosts.forEach(function(post) { post.style.display = 'flex'; });
                btn.setAttribute('data-expanded', 'true');
                btn.innerText = 'Ocultar histórico';
            }
        }

        function openModal(articleKey, buttonElement) {
            var modal = document.getElementById('articleModal');
            var modalBody = document.getElementById('modalBody');
            var data = articlesData[articleKey];
            
            if (data && modal && modalBody) {
                var imageHtml = '';
                var imageUrl = data.modalImg || '';

                if (!imageUrl && buttonElement) {
                    var postCard = buttonElement.closest('.post');
                    if (postCard) {
                        var coverDiv = postCard.querySelector('.cover');
                        if (coverDiv) {
                            var bgStyle = window.getComputedStyle(coverDiv).backgroundImage;
                            var match = bgStyle.match(/url\(['"]?([^'"]+)['"]?\)/);
                            if (match && match[1]) imageUrl = match[1];
                        }
                    }
                }

                if (imageUrl) {
                    var cleanTitle = data.title.replace(/<\/?[^>]+(>|$)/g, "");
                    imageHtml = '<div style="text-align: center; margin-bottom: 20px;"><img src="' + imageUrl + '" alt="' + cleanTitle + '" style="max-width: 100%; height: auto; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);"></div>';
                }

                modalBody.innerHTML = 
                    '<small style="color:var(--muted); font-size:.72rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase;">' + data.meta + '</small>' +
                    '<h2 style="font-size:1.8rem; margin:10px 0 20px;">' + data.title + '</h2>' +
                    imageHtml +
                    '<div class="article-text">' + data.content + '</div>';
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            }
        }

        function closeModal() {
            var modal = document.getElementById('articleModal');
            if (modal) {
                modal.style.display = 'none';
                document.body.style.overflow = 'auto';
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initApp);
        } else {
            initApp();
        }

        function initApp() {
            renderCalendar();

            var prevBtn = document.getElementById('calPrevBtn');
            var nextBtn = document.getElementById('calNextBtn');
            if (prevBtn) prevBtn.onclick = function() { currentCalDate.setMonth(currentCalDate.getMonth() - 1); renderCalendar(); };
            if (nextBtn) nextBtn.onclick = function() { currentCalDate.setMonth(currentCalDate.getMonth() + 1); renderCalendar(); };

            var btnLatest = document.getElementById('btnLatestPost');
            if (btnLatest) btnLatest.onclick = goToLatestPost;

            document.querySelectorAll('.btn-lang').forEach(function(btn) {
                btn.onclick = function() {
                    var lang = btn.getAttribute('data-lang');
                    var select = document.querySelector(".goog-te-combo");
                    if (select) {
                        select.value = lang;
                        select.dispatchEvent(new Event('change'));
                    }
                };
            });

            document.querySelectorAll('.btn-open-modal').forEach(function(btn) {
                btn.onclick = function() {
                    var key = btn.getAttribute('data-key');
                    openModal(key, btn);
                };
            });

            document.querySelectorAll('.btn-archive').forEach(function(btn) {
                btn.onclick = function() {
                    var gridId = btn.getAttribute('data-grid');
                    toggleArchive(gridId, btn);
                };
            });

            var closeBtn = document.getElementById('modalCloseBtn');
            if (closeBtn) closeBtn.onclick = closeModal;
            var modal = document.getElementById('articleModal');
            if (modal) modal.onclick = function(e) { if (e.target === modal) closeModal(); };

            var isAmbientPlaying = false;
            var audioEl = document.getElementById('bgAudio');
            var playBtn = document.getElementById('playPauseBtn');
            var statusTxt = document.getElementById('ambientStatusText');

            if (playBtn && audioEl) {
                playBtn.onclick = function() {
                    if (isAmbientPlaying) {
                        audioEl.pause();
                        playBtn.innerText = "▶";
                        if (statusTxt) statusTxt.innerText = "Música ambiental";
                        isAmbientPlaying = false;
                    } else {
                        audioEl.play().then(function() {
                            playBtn.innerText = "⏸";
                            if (statusTxt) statusTxt.innerText = "Reproduciendo";
                            isAmbientPlaying = true;
                        }).catch(function(e) { console.log("Error de audio:", e); });
                    }
                };
            }

            var searchInput = document.getElementById('searchInput');
            if (searchInput) {
                searchInput.onkeyup = function() {
                    var q = searchInput.value.toLowerCase().trim();
                    document.querySelectorAll('.post').forEach(function(post) {
                        var text = post.innerText.toLowerCase();
                        if (q === "") {
                            post.style.display = post.classList.contains('hidden-archive') ? 'none' : 'flex';
                        } else {
                            post.style.display = text.includes(q) ? 'flex' : 'none';
                        }
                    });
                };
            }

            var baseMinima = 288;
            var visitasAlmacenadas = localStorage.getItem('blog_visitas_totales');
            var totalVisitas = visitasAlmacenadas ? parseInt(visitasAlmacenadas, 10) : baseMinima;
            if (!sessionStorage.getItem('visita_registrada')) {
                totalVisitas += 1;
                localStorage.setItem('blog_visitas_totales', totalVisitas);
                sessionStorage.setItem('visita_registrada', 'true');
            }
            var counterEl = document.getElementById('counterValue');
            if (counterEl) counterEl.innerText = Math.max(baseMinima, totalVisitas);

            initPoolCanvas();
            initEarthCanvas();
            initCosmosCanvas();
        }

        // --- 1. Partículas flotantes de colores para #lugares (Memoria viva) ---
        function initPoolCanvas() {
            var canvas = document.getElementById('poolCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var width, height;
            var particles = [];
            var colors = ['#e64b35', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899'];

            function resize() {
                width = canvas.width = canvas.offsetWidth;
                height = canvas.height = canvas.offsetHeight;
            }
            resize();
            window.addEventListener('resize', resize);

            for (var i = 0; i < 50; i++) {
                particles.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    r: 2 + Math.random() * 3.5,
                    vx: (Math.random() - 0.5) * 0.6,
                    vy: (Math.random() - 0.5) * 0.6,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    alpha: 0.3 + Math.random() * 0.5
                });
            }

            function draw() {
                ctx.clearRect(0, 0, width, height);

                particles.forEach(function(p) {
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = width;
                    if (p.x > width) p.x = 0;
                    if (p.y < 0) p.y = height;
                    if (p.y > height) p.y = 0;

                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = p.color;
                    ctx.globalAlpha = p.alpha;
                    ctx.fill();
                    ctx.globalAlpha = 1.0;
                });

                requestAnimationFrame(draw);
            }
            requestAnimationFrame(draw);
        }

        // --- 2. Earth, Moon & Shooting Stars for #ciencia ---
        function initEarthCanvas() {
            var canvas = document.getElementById('earthCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var width, height;
            var rotation = 0;
            var moonAngle = 0;
            var stars = [];
            var shootingStars = [];

            function resize() {
                width = canvas.width = canvas.offsetWidth;
                height = canvas.height = canvas.offsetHeight;
                stars = [];
                for (var i = 0; i < 150; i++) {
                    stars.push({
                        x: Math.random() * width,
                        y: Math.random() * height,
                        r: Math.random() * 1.5,
                        alpha: 0.3 + Math.random() * 0.7,
                        twinkle: Math.random() * Math.PI * 2
                    });
                }
            }
            resize();
            window.addEventListener('resize', resize);

            function spawnShootingStar() {
                if (Math.random() > 0.98 && shootingStars.length < 2) {
                    shootingStars.push({
                        x: Math.random() * width,
                        y: Math.random() * height * 0.5,
                        len: 50 + Math.random() * 60,
                        speed: 7 + Math.random() * 4,
                        angle: Math.PI / 4 + (Math.random() - 0.5) * 0.2,
                        life: 1
                    });
                }
            }

            function drawEarth(cx, cy, radius, rot) {
                var glow = ctx.createRadialGradient(cx, cy, radius * 0.7, cx, cy, radius * 1.4);
                glow.addColorStop(0, 'rgba(80, 160, 255, 0)');
                glow.addColorStop(0.7, 'rgba(60, 140, 255, 0.1)');
                glow.addColorStop(1, 'rgba(30, 100, 220, 0)');
                ctx.beginPath();
                ctx.arc(cx, cy, radius * 1.4, 0, Math.PI * 2);
                ctx.fillStyle = glow;
                ctx.fill();

                ctx.save();
                ctx.beginPath();
                ctx.arc(cx, cy, radius, 0, Math.PI * 2);
                ctx.clip();

                var ocean = ctx.createRadialGradient(cx - radius * 0.3, cy - radius * 0.3, 0, cx, cy, radius);
                ocean.addColorStop(0, '#3a8fd0');
                ocean.addColorStop(0.6, '#1a5f9e');
                ocean.addColorStop(1, '#0d3a6b');
                ctx.fillStyle = ocean;
                ctx.fillRect(cx - radius, cy - radius, radius * 2, radius * 2);

                ctx.translate(cx, cy);
                ctx.rotate(rot);
                ctx.fillStyle = 'rgba(60, 140, 70, 0.85)';

                ctx.beginPath();
                ctx.ellipse(-radius * 0.15, -radius * 0.1, radius * 0.28, radius * 0.45, 0.2, 0, Math.PI * 2);
                ctx.fill();

                ctx.beginPath();
                ctx.ellipse(radius * 0.55, 0, radius * 0.18, radius * 0.55, -0.3, 0, Math.PI * 2);
                ctx.fill();

                ctx.beginPath();
                ctx.ellipse(-radius * 0.55, -radius * 0.25, radius * 0.35, radius * 0.25, 0.4, 0, Math.PI * 2);
                ctx.fill();

                ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';
                ctx.beginPath();
                ctx.ellipse(radius * 0.1, -radius * 0.35, radius * 0.4, radius * 0.12, 0.5, 0, Math.PI * 2);
                ctx.fill();

                ctx.restore();

                var light = ctx.createRadialGradient(cx - radius * 0.4, cy - radius * 0.35, 0, cx, cy, radius);
                light.addColorStop(0, 'rgba(255, 255, 255, 0.15)');
                light.addColorStop(0.5, 'rgba(0, 0, 0, 0)');
                light.addColorStop(1, 'rgba(0, 0, 0, 0.4)');
                ctx.beginPath();
                ctx.arc(cx, cy, radius, 0, Math.PI * 2);
                ctx.fillStyle = light;
                ctx.fill();

                ctx.beginPath();
                ctx.arc(cx, cy, radius, 0, Math.PI * 2);
                ctx.strokeStyle = 'rgba(140, 200, 255, 0.4)';
                ctx.lineWidth = 2;
                ctx.stroke();
            }

            function drawMoon(cx, cy, earthRadius) {
                var orbitRadius = earthRadius * 2.2;
                moonAngle += 0.003;
                var moonX = cx + Math.cos(moonAngle) * orbitRadius;
                var moonY = cy + Math.sin(moonAngle) * (orbitRadius * 0.5);

                ctx.beginPath();
                ctx.arc(moonX, moonY, 9, 0, Math.PI * 2);
                var moonGrad = ctx.createRadialGradient(moonX - 3, moonY - 3, 1, moonX, moonY, 9);
                moonGrad.addColorStop(0, '#e2e8f0');
                moonGrad.addColorStop(0.7, '#94a3b8');
                moonGrad.addColorStop(1, '#475569');
                ctx.fillStyle = moonGrad;
                ctx.fill();
                ctx.strokeStyle = 'rgba(255,255,255,0.2)';
                ctx.lineWidth = 1;
                ctx.stroke();
            }

            function draw(t) {
                ctx.clearRect(0, 0, width, height);

                ctx.fillStyle = '#000008';
                ctx.fillRect(0, 0, width, height);

                stars.forEach(function(s) {
                    var a = s.alpha * (0.5 + 0.5 * Math.sin(t * 0.002 + s.twinkle));
                    ctx.beginPath();
                    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(255, 255, 255, ' + a + ')';
                    ctx.fill();
                });

                spawnShootingStar();
                for (var i = shootingStars.length - 1; i >= 0; i--) {
                    var ss = shootingStars[i];
                    ss.x += Math.cos(ss.angle) * ss.speed;
                    ss.y += Math.sin(ss.angle) * ss.speed;
                    ss.life -= 0.015;

                    if (ss.life <= 0) {
                        shootingStars.splice(i, 1);
                        continue;
                    }

                    var tailX = ss.x - Math.cos(ss.angle) * ss.len;
                    var tailY = ss.y - Math.sin(ss.angle) * ss.len;

                    var grd = ctx.createLinearGradient(ss.x, ss.y, tailX, tailY);
                    grd.addColorStop(0, 'rgba(255, 255, 255, ' + ss.life + ')');
                    grd.addColorStop(1, 'rgba(180, 200, 255, 0)');
                    ctx.beginPath();
                    ctx.moveTo(ss.x, ss.y);
                    ctx.lineTo(tailX, tailY);
                    ctx.strokeStyle = grd;
                    ctx.lineWidth = 2;
                    ctx.stroke();
                }

                rotation += 0.002;
                var cx = width * 0.5;
                var cy = height * 0.52;
                var radius = Math.min(width, height) * 0.26;

                drawEarth(cx, cy, radius, rotation);
                drawMoon(cx, cy, radius);

                requestAnimationFrame(draw);
            }
            requestAnimationFrame(draw);
        }

        // --- 3. Cosmos / Starfield for #sobre ---
        function initCosmosCanvas() {
            var canvas = document.getElementById('cosmosCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var width, height;
            var stars = [];
            var shootingStars = [];

            function resize() {
                width = canvas.width = canvas.offsetWidth;
                height = canvas.height = canvas.offsetHeight;
                stars = [];
                for (var i = 0; i < 180; i++) {
                    stars.push({
                        x: Math.random() * width,
                        y: Math.random() * height,
                        r: Math.random() * 1.6,
                        alpha: 0.2 + Math.random() * 0.8,
                        speed: 0.05 + Math.random() * 0.15,
                        twinkle: Math.random() * Math.PI * 2
                    });
                }
            }
            resize();
            window.addEventListener('resize', resize);

            function spawnShootingStar() {
                if (Math.random() > 0.985 && shootingStars.length < 2) {
                    shootingStars.push({
                        x: Math.random() * width,
                        y: Math.random() * height * 0.4,
                        len: 40 + Math.random() * 60,
                        speed: 6 + Math.random() * 5,
                        angle: Math.PI / 4 + (Math.random() - 0.5) * 0.3,
                        life: 1
                    });
                }
            }

            function draw(t) {
                ctx.fillStyle = 'rgba(2, 4, 18, 0.25)';
                ctx.fillRect(0, 0, width, height);

                stars.forEach(function(s) {
                    s.y += s.speed;
                    if (s.y > height) {
                        s.y = 0;
                        s.x = Math.random() * width;
                    }
                    var a = s.alpha * (0.6 + 0.4 * Math.sin(t * 0.003 + s.twinkle));
                    ctx.beginPath();
                    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(220, 230, 255, ' + a + ')';
                    ctx.fill();
                });

                spawnShootingStar();
                for (var i = shootingStars.length - 1; i >= 0; i--) {
                    var ss = shootingStars[i];
                    ss.x += Math.cos(ss.angle) * ss.speed;
                    ss.y += Math.sin(ss.angle) * ss.speed;
                    ss.life -= 0.015;

                    if (ss.life <= 0) {
                        shootingStars.splice(i, 1);
                        continue;
                    }

                    var tailX = ss.x - Math.cos(ss.angle) * ss.len;
                    var tailY = ss.y - Math.sin(ss.angle) * ss.len;

                    var grd = ctx.createLinearGradient(ss.x, ss.y, tailX, tailY);
                    grd.addColorStop(0, 'rgba(255, 255, 255, ' + ss.life + ')');
                    grd.addColorStop(1, 'rgba(180, 200, 255, 0)');
                    ctx.beginPath();
                    ctx.moveTo(ss.x, ss.y);
                    ctx.lineTo(tailX, tailY);
                    ctx.strokeStyle = grd;
                    ctx.lineWidth = 2;
                    ctx.stroke();
                }

                requestAnimationFrame(draw);
            }

            ctx.fillStyle = '#020412';
            ctx.fillRect(0, 0, width, height);
            requestAnimationFrame(draw);
        }
    </script>
