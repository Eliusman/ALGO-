        function filterArticles() {
            const queryInput = document.getElementById('searchInput');
            if (!queryInput) return;
            const query = queryInput.value.toLowerCase().trim();
            const posts = document.querySelectorAll('.post');
            
            posts.forEach(post => {
                const text = post.innerText.toLowerCase();
                const parentGrid = post.closest('.grid');
                const btn = parentGrid ? parentGrid.parentElement.querySelector('.btn-archive') : null;
                const isExpanded = btn && btn.innerText.includes('Ocultar');
                const isInitiallyHidden = post.classList.contains('hidden-archive');
                
                if (query === "") {
                    if (isInitiallyHidden && !isExpanded) {
                        post.style.display = 'none';
                    } else {
                        post.style.display = 'flex';
                    }
                } else {
                    if (text.includes(query)) {
                        post.style.display = 'flex';
                    } else {
                        post.style.display = 'none';
                    }
                }
            });
        }
        window.filterArticles = filterArticles;

        const earthCanvas = document.getElementById('earthCanvas');
        if (earthCanvas) {
            const earthCtx = earthCanvas.getContext('2d');
            let earthImg = null;
            let cloudsImg = null;
            let moonImg = null;
            let spaceStars = [];
            let shootingStars = [];
            let rotation = 0;
            let cloudRotation = 0;
            let moonOrbitAngle = 0;
            const ROTATION_SPEED = 0.0012;        
            const CLOUD_ROTATION_SPEED = 0.00155;
            const MOON_ORBIT_SPEED = 0.0003;
            let globeRadius = 0;
            let moonRadius = 0;
            let orbitRadius = 0;
            let globeCenterX = 0;
            let globeCenterY = 0;

            const EARTH_TEXTURE_URL = 'https://threejs.org/examples/textures/planets/earth_atmos_2048.jpg';
            const CLOUDS_TEXTURE_URL = 'https://threejs.org/examples/textures/planets/earth_clouds_1024.png';
            const MOON_TEXTURE_URL = 'https://threejs.org/examples/textures/planets/moon_1024.jpg';

            function initEarthCanvas() {
                const parent = earthCanvas.parentElement;
                if (!parent) return;

                const dpr = Math.min(window.devicePixelRatio || 1, 2);
                const width = parent.offsetWidth;
                const height = parent.offsetHeight;

                earthCanvas.width = width * dpr;
                earthCanvas.height = height * dpr;
                earthCanvas.style.width = width + 'px';
                earthCanvas.style.height = height + 'px';
                earthCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

                const isMobile = width < 700;
                globeRadius = isMobile ? Math.min(78, width * 0.19) : 95;
                moonRadius = globeRadius * 0.27;
                orbitRadius = globeRadius * 5.7;
                globeCenterX = width * 0.5;
                globeCenterY = isMobile ? 115 : 130;

                spaceStars = [];
                const starCount = Math.floor((width * height) / 1400);
                for (let i = 0; i < starCount; i++) {
                    spaceStars.push({
                        x: Math.random() * width,
                        y: Math.random() * height,
                        radius: Math.random() * 1.9 + 0.5,
                        baseAlpha: 0.55 + Math.random() * 0.45,
                        speed: 0.45 + Math.random() * 0.70,
                        phase: Math.random() * Math.PI * 2
                    });
                }

                shootingStars = [];

                if (!earthImg) {
                    earthImg = new Image();
                    earthImg.crossOrigin = 'anonymous';
                    earthImg.src = EARTH_TEXTURE_URL;
                }
                if (!cloudsImg) {
                    cloudsImg = new Image();
