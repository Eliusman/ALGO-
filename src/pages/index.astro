        }
        .legend-item { display: flex; align-items: center; gap: 8px; }
        .calendar-legend-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; box-shadow: 0 3px 8px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.35); }
        .calendar-legend-dot.latest { background: linear-gradient(145deg, #ff3d81, #ff7a18); }
        .calendar-legend-dot.past { background: linear-gradient(145deg, #00b8d9, #2563eb); }
