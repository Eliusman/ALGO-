        let currentCalDate = new Date(2026, 9, 1);
        const monthNames = [
            "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
            "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
        ];

        function renderCalendar() {
            const year = currentCalDate.getFullYear();
            const month = currentCalDate.getMonth();
            const titleEl = document.getElementById('calMonthTitle');
            if (titleEl) titleEl.innerText = `${monthNames[month]} ${year}`;
            
            const container = document.getElementById('calendarDays');
            if (!container) return;
            container.innerHTML = '';
            
            let firstDayIndex = new Date(year, month, 1).getDay();
            firstDayIndex = (firstDayIndex === 0) ? 6 : firstDayIndex - 1;
            
            const totalDays = new Date(year, month + 1, 0).getDate();
            const postDates = Object.keys(publishedPosts);
            const latestDateKey = postDates.length > 0 ? postDates.reduce((latest, current) => current > latest ? current : latest) : null;
            
            for (let i = 0; i < firstDayIndex; i++) {
                const emptyDiv = document.createElement('div');
                emptyDiv.className = 'calendar-day empty';
                container.appendChild(emptyDiv);
            }
            
            for (let day = 1; day <= totalDays; day++) {
                const dayDiv = document.createElement('div');
                dayDiv.className = 'calendar-day';
                dayDiv.innerText = day;
                
                const formattedMonth = String(month + 1).padStart(2, '0');
                const formattedDay = String(day).padStart(2, '0');
                const dateKey = `${year}-${formattedMonth}-${formattedDay}`;
                
                let hasPost = false;
                if (publishedPosts[dateKey]) {
                    hasPost = true;
                    const postInfo = publishedPosts[dateKey];
                    const isLatest = (dateKey === latestDateKey);
                    
                    if (isLatest) {
                        dayDiv.classList.add('latest-post');
                        dayDiv.title = 'Ir a la última publicación';
                    } else {
                        dayDiv.classList.add('past-post');
                        dayDiv.title = 'Ir a la publicación';
                    }
                    dayDiv.onclick = () => window.goToArticle(postInfo.id);
                }

                const today = new Date();
                const todayKey = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
                if (dateKey === todayKey && !hasPost) {
                    dayDiv.classList.add('today');
                    dayDiv.title = 'Hoy';
                }

                container.appendChild(dayDiv);
            }
        }

        function goToArticle(articleId) {
            const articleElement = document.getElementById('post-' + articleId);
            if (!articleElement) return;

            const parentGrid = articleElement.closest('.grid');
            if (articleElement.classList.contains('hidden-archive')) {
                articleElement.style.display = 'flex';
                articleElement.classList.remove('hidden-archive');
                const btn = parentGrid ? parentGrid.parentElement.querySelector('.btn-archive') : null;
                if (btn) {
                    const hiddenCount = parentGrid.querySelectorAll('.post.hidden-archive').length;
                    const sectionId = parentGrid.parentElement.getAttribute('data-section-id');
                    if (sectionId === 'musica') {
                        btn.innerText = hiddenCount > 0 ? `Ver histórico de música (+${hiddenCount})` : 'Ocultar histórico de música';
                    } else if (sectionId === 'estrellas') {
                        btn.innerText = hiddenCount > 0 ? `Ver histórico de estrellas (+${hiddenCount})` : 'Ocultar histórico de estrellas';
                    } else if (sectionId === 'sinpermiso') {
                        btn.innerText = hiddenCount > 0 ? `Ver histórico de lo encontré (+${hiddenCount})` : 'Ocultar histórico de lo encontré';
                    } else if (sectionId === 'lugares') {
                        btn.innerText = hiddenCount > 0 ? `Ver artículos en histórico (+${hiddenCount})` : 'Ocultar históricos';
                    } else if (sectionId === 'pensamientos') {
                        btn.innerText = hiddenCount > 0 ? `Ver artículos en histórico (+${hiddenCount})` : 'Ocultar históricos';
                    }
                }
            }

            articleElement.scrollIntoView({ behavior: 'smooth', block: 'center' });

            articleElement.classList.add('highlight-post');
            setTimeout(() => {
                articleElement.classList.remove('highlight-post');
            }, 2000);
        }
        window.goToArticle = goToArticle;

        function goToLatestPost() {
            const allPosts = document.querySelectorAll('.post');
            let latestPost = null;
            let latestDate = '';

            allPosts.forEach(post => {
                const postDate = post.getAttribute('data-datetime') || '';
                if (postDate > latestDate) {
                    latestDate = postDate;
                    latestPost = post;
                }
            });

            if (latestPost && latestPost.id) {
                const articleId = latestPost.id.replace('post-', '');
                goToArticle(articleId);
            }
        }
        window.goToLatestPost = goToLatestPost;

