        var currentCalDate = new Date(2026, 9, 1);
        var monthNames = [
            "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
            "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
        ];

        function renderCalendar() {
            var year = currentCalDate.getFullYear();
            var month = currentCalDate.getMonth();
            var calTitle = document.getElementById('calMonthTitle');
            if (calTitle) calTitle.innerText = monthNames[month] + " " + year;
            
            var container = document.getElementById('calendarDays');
            if (!container) return;
            container.innerHTML = '';
            
            var firstDayIndex = new Date(year, month, 1).getDay();
            firstDayIndex = (firstDayIndex === 0) ? 6 : firstDayIndex - 1;
            
            var totalDays = new Date(year, month + 1, 0).getDate();
            var postDates = Object.keys(publishedPosts);
            var latestDateKey = postDates.length > 0 ? postDates.reduce(function(latest, current) { return current > latest ? current : latest; }) : null;
            
            for (var i = 0; i < firstDayIndex; i++) {
                var emptyDiv = document.createElement('div');
                emptyDiv.className = 'calendar-day empty';
                container.appendChild(emptyDiv);
            }
            
            for (var day = 1; day <= totalDays; day++) {
                (function(d) {
                    var dayDiv = document.createElement('div');
                    dayDiv.className = 'calendar-day';
                    dayDiv.innerText = d;
                    
                    var formattedMonth = String(month + 1).padStart(2, '0');
                    var formattedDay = String(d).padStart(2, '0');
                    var dateKey = year + '-' + formattedMonth + '-' + formattedDay;
                    
                    var hasPost = false;
                    if (publishedPosts[dateKey]) {
                        hasPost = true;
                        var postInfo = publishedPosts[dateKey];
                        var isLatest = (dateKey === latestDateKey);
                        
                        if (isLatest) {
                            dayDiv.classList.add('latest-post');
                            dayDiv.title = 'Ir a la última publicación';
                        } else {
                            dayDiv.classList.add('past-post');
                            dayDiv.title = 'Ir a la publicación';
                        }
                        dayDiv.onclick = function() { goToArticle(postInfo.id); };
                    }

                    var today = new Date();
                    var todayKey = today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0');
                    if (dateKey === todayKey && !hasPost) {
                        dayDiv.classList.add('today');
                        dayDiv.title = 'Hoy';
                    }

                    container.appendChild(dayDiv);
                })(day);
            }
        }

        function goToArticle(articleId) {
            var articleElement = document.getElementById('post-' + articleId);
            if (!articleElement) return;

            if (articleElement.classList.contains('hidden-archive')) {
                articleElement.style.display = 'flex';
                articleElement.classList.remove('hidden-archive');
            }

            articleElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
            articleElement.classList.add('highlight-post');
            setTimeout(function() {
                articleElement.classList.remove('highlight-post');
            }, 2000);
        }

        function goToLatestPost() {
            var allPosts = document.querySelectorAll('.post');
            var latestPost = null;
            var latestDate = '';

            allPosts.forEach(function(post) {
                var postDate = post.getAttribute('data-datetime') || '';
                if (postDate > latestDate) {
                    latestDate = postDate;
                    latestPost = post;
                }
            });

            if (latestPost && latestPost.id) {
                var articleId = latestPost.id.replace('post-', '');
                goToArticle(articleId);
            }
        }

        function toggleArchive(gridId, btn) {
            var grid = document.getElementById(gridId);
            if (!grid) return;
            var hiddenPosts = grid.querySelectorAll('.post.hidden-archive');
            var isExpanded = btn.getAttribute('data-expanded') === 'true';
            
            if (isExpanded) {
                hiddenPosts.forEach(function(post) { post.style.display = 'none'; });
                btn.setAttribute('data-expanded', 'false');
                btn.innerText = 'Ver artículos en histórico (+' + hiddenPosts.length + ')';
            } else {
                hiddenPosts.forEach(function(post) { post.style.display = 'flex'; });
                btn.setAttribute('data-expanded', 'true');
                btn.innerText = 'Ocultar histórico';
            }
        }

        function openModal(articleKey, buttonElement) {
            var modal = document.getElementById('articleModal');
            var modalBody = document.getElementById('modalBody');
            var data = articlesData[articleKey];
            
            if (data && modal && modalBody) {
                var imageHtml = '';
                var imageUrl = data.modalImg || '';

                if (!imageUrl && buttonElement) {
                    var postCard = buttonElement.closest('.post');
                    if (postCard) {
                        var coverDiv = postCard.querySelector('.cover');
                        if (coverDiv) {
                            var bgStyle = window.getComputedStyle(coverDiv).backgroundImage;
                            var match = bgStyle.match(/url\(['"]?([^'"]+)['"]?\)/);
                            if (match && match[1]) imageUrl = match[1];
                        }
                    }
                }

                if (imageUrl) {
                    var cleanTitle = data.title.replace(/<\/?[^>]+(>|$)/g, "");
                    imageHtml = '<div style="text-align: center; margin-bottom: 20px;"><img src="' + imageUrl + '" alt="' + cleanTitle + '" style="max-width: 100%; height: auto; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);"></div>';
                }

                modalBody.innerHTML = 
                    '<small style="color:var(--muted); font-size:.72rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase;">' + data.meta + '</small>' +
                    '<h2 style="font-size:1.8rem; margin:10px 0 20px;">' + data.title + '</h2>' +
                    imageHtml +
                    '<div class="article-text">' + data.content + '</div>';
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            }
        }

        function closeModal() {
            var modal = document.getElementById('articleModal');
            if (modal) {
                modal.style.display = 'none';
                document.body.style.overflow = 'auto';
            }
        }

        // Inicialización segura independiente del DOMContentLoaded en Astro
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initApp);
        } else {
            initApp();
        }

        function initApp() {
            renderCalendar();

            var prevBtn = document.getElementById('calPrevBtn');
            var nextBtn = document.getElementById('calNextBtn');
            if (prevBtn) prevBtn.onclick = function() { currentCalDate.setMonth(currentCalDate.getMonth() - 1); renderCalendar(); };
            if (nextBtn) nextBtn.onclick = function() { currentCalDate.setMonth(currentCalDate.getMonth() + 1); renderCalendar(); };

            var btnLatest = document.getElementById('btnLatestPost');
            if (btnLatest) btnLatest.onclick = goToLatestPost;

            document.querySelectorAll('.btn-lang').forEach(function(btn) {
                btn.onclick = function() {
                    var lang = btn.getAttribute('data-lang');
                    var select = document.querySelector(".goog-te-combo");
                    if (select) {
                        select.value = lang;
                        select.dispatchEvent(new Event('change'));
                    }
                };
            });

            document.querySelectorAll('.btn-open-modal').forEach(function(btn) {
                btn.onclick = function() {
                    var key = btn.getAttribute('data-key');
                    openModal(key, btn);
                };
            });

            document.querySelectorAll('.btn-archive').forEach(function(btn) {
                btn.onclick = function() {
                    var gridId = btn.getAttribute('data-grid');
                    toggleArchive(gridId, btn);
                };
            });

            var closeBtn = document.getElementById('modalCloseBtn');
            if (closeBtn) closeBtn.onclick = closeModal;
            var modal = document.getElementById('articleModal');
            if (modal) modal.onclick = function(e) { if (e.target === modal) closeModal(); };

            var isAmbientPlaying = false;
            var audioEl = document.getElementById('bgAudio');
            var playBtn = document.getElementById('playPauseBtn');
            var statusTxt = document.getElementById('ambientStatusText');

            if (playBtn && audioEl) {
                playBtn.onclick = function() {
                    if (isAmbientPlaying) {
                        audioEl.pause();
                        playBtn.innerText = "▶";
                        if (statusTxt) statusTxt.innerText = "Música ambiental";
                        isAmbientPlaying = false;
                    } else {
                        audioEl.play().then(function() {
                            playBtn.innerText = "⏸";
                            if (statusTxt) statusTxt.innerText = "Reproduciendo";
                            isAmbientPlaying = true;
                        }).catch(function(e) { console.log("Error de audio:", e); });
                    }
                };
            }

            var searchInput = document.getElementById('searchInput');
            if (searchInput) {
                searchInput.onkeyup = function() {
                    var q = searchInput.value.toLowerCase().trim();
                    document.querySelectorAll('.post').format = ... // safe query
                    document.querySelectorAll('.post').forEach(function(post) {
                        var text = post.innerText.toLowerCase();
                        post.style.display = (q === "" ? (post.classList.contains('hidden-archive') ? 'none' : 'flex') : (text.includes(q) ? 'flex' : 'none'));
                    });
                };
            }

            var baseMinima = 288;
            var visitasAlmacenadas = localStorage.getItem('blog_visitas_totales');
            var totalVisitas = visitasAlmacenadas ? parseInt(visitasAlmacenadas, 10) : baseMinima;
            if (!sessionStorage.getItem('visita_registrada')) {
                totalVisitas += 1;
                localStorage.setItem('blog_visitas_totales', totalVisitas);
                sessionStorage.setItem('visita_registrada', 'true');
            }
            var counterEl = document.getElementById('counterValue');
            if (counterEl) counterEl.innerText = Math.max(baseMinima, totalVisitas);

            try {
                var poolCanvas = document.getElementById('poolCanvas');
                if (poolCanvas) {
                    poolCanvas.width = poolCanvas.offsetWidth;
                    poolCanvas.height = poolCanvas.offsetHeight;
                }
                var earthCanvas = document.getElementById('earthCanvas');
                if (earthCanvas) {
                    earthCanvas.width = earthCanvas.offsetWidth;
                    earthCanvas.height = earthCanvas.offsetHeight;
                }
            } catch(err) {
                console.log("Canvas init notice:", err);
            }
        }
    </script>
